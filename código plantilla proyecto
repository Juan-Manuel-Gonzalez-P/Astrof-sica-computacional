#





# Energía cinética del protón.
#
# En todas las simulaciones principales se mantiene
# K = 10 MeV para que los casos puedan compararse
# usando la misma partícula.

MeV = 1.602176634e-13

K = 10 * MeV


# A partir de la energía calculo el factor relativista.


gamma = 1 + K/(m*c**2)


v_total = c * np.sqrt(
    1 - 1/gamma**2
)


# Ecuaciones de movimiento.

 dr/dt = v

 dv/dt = q/(gamma*m) * (v x B)


def derivadas(estado):

    # Las tres primeras componentes representan la posición.
    r = estado[:3]

    # Las tres últimas representan la velocidad.
    v = estado[3:]

    # Se evalúa el campo magnético en la posición actual.
    B = campo(r)

    
    drdt = v

    # La fuerza de Lorentz determina cómo cambia
    # la dirección de la velocidad.
    dvdt = (
        q/(gamma*m)
        * np.cross(v, B)
    )

    # Junto posición y velocidad para integrar
    # las seis ecuaciones al mismo tiempo.
    return np.concatenate(
        (drdt, dvdt)
    )


# Método Runge-Kutta de segundo orden.


def rk2(estado0, dt, tiempo_total):

    pasos = int(
        tiempo_total/dt
    )

    estados = [
        estado0.copy()
    ]

    tiempos = [
        0.0
    ]


    for i in range(pasos):

        estado = estados[-1]

        # Primera pendiente
        k1 = derivadas(
            estado
        )

        # Estimación en la mitad del intervalo
        estado_medio = (
            estado
            + dt*k1/2
        )

        # Segunda pendiente
        k2 = derivadas(
            estado_medio
        )

        # Nuevo estado
        nuevo_estado = (
            estado
            + dt*k2
        )

        estados.append(
            nuevo_estado
        )

        tiempos.append(
            (i + 1)*dt
        )


        # Para los casos de partículas incidentes,
        # se puede detener la simulación si el protón
        # llega a la superficie:
        #
        # if np.linalg.norm(nuevo_estado[:3]) <= R:
        #     break


    return (
        np.array(tiempos),
        np.array(estados)
    )



