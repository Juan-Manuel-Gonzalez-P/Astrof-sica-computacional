# Campo producido por un dipolo localizado
def dipolo_local(r, posicion, direccion, C):

    dr = r - posicion
    distancia = np.linalg.norm(dr)

    if distancia == 0:
        return np.zeros(3)

    direccion = direccion / np.linalg.norm(direccion)

    producto = np.dot(
        direccion,
        dr
    )

    B = (
        C / distancia**5
        * (
            3*producto*dr
            - distancia**2*direccion
        )
    )

    return B


# Para Marte uso tres regiones magnéticas locales.
# La idea es representar de forma sencilla que el planeta
# no tiene un dipolo global como la Tierra.
def campo_marte(r):

    p1 = np.array([
        0.0,
        0.0,
        -0.85*RM
    ])

    p2 = np.array([
        0.35*RM,
        0.10*RM,
        -0.82*RM
    ])

    p3 = np.array([
        -0.30*RM,
        0.25*RM,
        -0.80*RM
    ])


    d1 = np.array([
        0.0,
        0.0,
        1.0
    ])

    d2 = np.array([
        0.4,
        0.1,
        1.0
    ])

    d3 = np.array([
        -0.3,
        0.4,
        1.0
    ])


    B_ref = 1.5e-6

    profundidad = 0.15*RM

    C = (
        B_ref
        * profundidad**3
        / 2
    )


    B1 = dipolo_local(
        r,
        p1,
        d1,
        C
    )

    B2 = dipolo_local(
        r,
        p2,
        d2,
        0.8*C
    )

    B3 = dipolo_local(
        r,
        p3,
        d3,
        0.6*C
    )

    return B1 + B2 + B3


