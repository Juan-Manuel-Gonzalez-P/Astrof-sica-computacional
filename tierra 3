import numpy as np
import matplotlib.pyplot as plt


# Constantes físicas
q = 1.602176634e-19
m = 1.6726219e-27
c = 2.99792458e8

RE = 6.378e6
B0 = 3.07e-5


# Campo dipolar terrestre
def campo_tierra(r):

    x, y, z = r

    R = np.sqrt(x**2 + y**2 + z**2)

    if R == 0:
        return np.zeros(3)

    factor = B0 * RE**3 / R**5

    Bx = factor * 3*x*z
    By = factor * 3*y*z
    Bz = factor * (3*z**2 - R**2)

    return np.array([Bx, By, Bz])


# Energía del protón
MeV = 1.602176634e-13

K = 10 * MeV


# Rapidez relativista correspondiente a 10 MeV
gamma = 1 + K/(m*c**2)

v_total = c * np.sqrt(
    1 - 1/gamma**2
)


# Ecuaciones de movimiento
def derivadas(estado):

    r = estado[:3]
    v = estado[3:]

    B = campo_tierra(r)

    drdt = v

    dvdt = (
        q/(gamma*m)
        * np.cross(v, B)
    )

    return np.concatenate(
        (drdt, dvdt)
    )


# Integración con RK2
def rk2(estado0, dt, tiempo_total):

    pasos = int(tiempo_total/dt)

    estados = [estado0.copy()]
    tiempos = [0.0]

    for i in range(pasos):

        estado = estados[-1]

        k1 = derivadas(estado)

        estado_medio = (
            estado
            + dt*k1/2
        )

        k2 = derivadas(
            estado_medio
        )

        nuevo_estado = (
            estado
            + dt*k2
        )

        estados.append(
            nuevo_estado
        )

        tiempos.append(
            (i + 1)*dt
        )


        # Detengo el cálculo si el protón toca la Tierra
        if np.linalg.norm(nuevo_estado[:3]) <= RE:
            break

    return (
        np.array(tiempos),
        np.array(estados)
    )


# El protón empieza lejos de la Tierra y desplazado
# respecto al eje x.
r0 = np.array([
    10.0*RE,
    3.0*RE,
    0.0
])


# La dirección de la velocidad apunta exactamente
# hacia el centro de la Tierra.
direccion = (
    -r0
    / np.linalg.norm(r0)
)

v0 = (
    v_total
    * direccion
)


estado0 = np.concatenate(
    (r0, v0)
)


# Parámetros numéricos
dt = 5e-6
tiempo_total = 2.0


t, solucion = rk2(
    estado0,
    dt,
    tiempo_total
)


r = solucion[:, :3]
v = solucion[:, 3:]


# Posición en radios terrestres
x = r[:, 0] / RE
y = r[:, 1] / RE
z = r[:, 2] / RE


# Distancia al centro terrestre
distancia = (
    np.linalg.norm(r, axis=1)
    / RE
)


# Rapidez y error numérico
rapidez = np.linalg.norm(
    v,
    axis=1
)

rapidez_inicial = np.linalg.norm(
    v0
)

error_rapidez = (
    np.abs(
        rapidez - rapidez_inicial
    )
    / rapidez_inicial
) * 100


# Campo magnético que experimenta la partícula
B_modulo = np.zeros(
    len(t)
)

for i in range(len(t)):

    B = campo_tierra(
        r[i]
    )

    B_modulo[i] = np.linalg.norm(
        B
    )


# Punto de máxima aproximación
indice_minimo = np.argmin(
    distancia
)

distancia_minima = distancia[
    indice_minimo
]


# Esfera terrestre
u = np.linspace(
    0,
    2*np.pi,
    40
)

theta = np.linspace(
    0,
    np.pi,
    25
)

xs = np.outer(
    np.cos(u),
    np.sin(theta)
)

ys = np.outer(
    np.sin(u),
    np.sin(theta)
)

zs = np.outer(
    np.ones(len(u)),
    np.cos(theta)
)


# Trayectoria tridimensional
fig = plt.figure(
    figsize=(9, 8)
)

ax = fig.add_subplot(
    111,
    projection="3d"
)


ax.plot_surface(
    xs,
    ys,
    zs,
    alpha=0.4
)


salto = 10

ax.plot(
    x[::salto],
    y[::salto],
    z[::salto],
    linewidth=1.3,
    label="Trayectoria del protón"
)

ax.scatter(
    x[0],
    y[0],
    z[0],
    s=45,
    label="Posición inicial"
)


# Esta recta muestra qué habría ocurrido si B = 0
lambda_recta = np.linspace(
    0,
    1,
    300
)

recta = (
    r0[None, :]
    + lambda_recta[:, None]
    * (-r0[None, :])
)

ax.plot(
    recta[:, 0]/RE,
    recta[:, 1]/RE,
    recta[:, 2]/RE,
    linestyle="--",
    linewidth=1,
    label="Trayectoria sin campo"
)


ax.set_xlim(
    -2,
    10.5
)

ax.set_ylim(
    -5,
    5
)

ax.set_zlim(
    -5,
    5
)

ax.set_xlabel(
    "x / $R_E$"
)

ax.set_ylabel(
    "y / $R_E$"
)

ax.set_zlabel(
    "z / $R_E$"
)

ax.set_title(
    "Protón incidente diagonalmente hacia la Tierra"
)

ax.legend()

plt.show()


# Vista en el plano x-y
plt.figure(
    figsize=(9, 6)
)

plt.plot(
    x,
    y,
    label="Con campo magnético"
)


# Trayectoria que seguiría sin campo
plt.plot(
    recta[:, 0]/RE,
    recta[:, 1]/RE,
    linestyle="--",
    label="Sin campo magnético"
)


# Circunferencia terrestre
angulo = np.linspace(
    0,
    2*np.pi,
    400
)

plt.plot(
    np.cos(angulo),
    np.sin(angulo)
)


plt.scatter(
    x[0],
    y[0],
    s=40,
    label="Posición inicial"
)


plt.axis("equal")

plt.xlabel(
    "x / $R_E$"
)

plt.ylabel(
    "y / $R_E$"
)

plt.title(
    "Desviación de una trayectoria incidente diagonal"
)

plt.grid()
plt.legend()

plt.show()


# Distancia al centro terrestre
plt.figure(
    figsize=(9, 5)
)

plt.plot(
    t,
    distancia
)

plt.axhline(
    1,
    linestyle="--"
)

plt.scatter(
    t[indice_minimo],
    distancia_minima,
    s=35
)

plt.xlabel(
    "Tiempo [s]"
)

plt.ylabel(
    r"$r/R_E$"
)

plt.title(
    "Distancia del protón al centro de la Tierra"
)

plt.grid()

plt.show()


# Campo magnético experimentado por el protón
plt.figure(
    figsize=(9, 5)
)

plt.plot(
    t,
    B_modulo
)

plt.xlabel(
    "Tiempo [s]"
)

plt.ylabel(
    "|B| [T]"
)

plt.title(
    "Campo magnético a lo largo de la trayectoria"
)

plt.grid()

plt.show()


# Error del método numérico
plt.figure(
    figsize=(9, 5)
)

plt.plot(
    t,
    error_rapidez
)

plt.xlabel(
    "Tiempo [s]"
)

plt.ylabel(
    "Error relativo [%]"
)

plt.title(
    "Error en la conservación de la rapidez"
)

plt.grid()

plt.show()
