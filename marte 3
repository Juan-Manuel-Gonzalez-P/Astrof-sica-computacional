import numpy as np
import matplotlib.pyplot as plt


# Constantes físicas
q = 1.602176634e-19
m = 1.6726219e-27
c = 2.99792458e8

RM = 3.3895e6


# Campo de un dipolo magnético localizado
def dipolo_local(r, posicion, direccion, C):

    dr = r - posicion
    distancia = np.linalg.norm(dr)

    if distancia == 0:
        return np.zeros(3)

    direccion = direccion / np.linalg.norm(direccion)

    producto = np.dot(
        direccion,
        dr
    )

    B = (
        C / distancia**5
        * (
            3*producto*dr
            - distancia**2*direccion
        )
    )

    return B


# Para Marte represento el campo como la suma de tres
# anomalías magnéticas localizadas principalmente
# en el hemisferio sur.
def campo_marte(r):

    p1 = np.array([
        0.0,
        0.0,
        -0.85*RM
    ])

    p2 = np.array([
        0.35*RM,
        0.10*RM,
        -0.82*RM
    ])

    p3 = np.array([
        -0.30*RM,
        0.25*RM,
        -0.80*RM
    ])


    d1 = np.array([
        0.0,
        0.0,
        1.0
    ])

    d2 = np.array([
        0.4,
        0.1,
        1.0
    ])

    d3 = np.array([
        -0.3,
        0.4,
        1.0
    ])


    B_ref = 1.5e-6

    profundidad = 0.15*RM

    C = (
        B_ref
        * profundidad**3
        / 2
    )


    B1 = dipolo_local(
        r,
        p1,
        d1,
        C
    )

    B2 = dipolo_local(
        r,
        p2,
        d2,
        0.8*C
    )

    B3 = dipolo_local(
        r,
        p3,
        d3,
        0.6*C
    )

    return B1 + B2 + B3


# Energía del protón
MeV = 1.602176634e-13

K = 10 * MeV


# Rapidez relativista correspondiente a 10 MeV
gamma = 1 + K/(m*c**2)

v_total = c * np.sqrt(
    1 - 1/gamma**2
)


# Ecuaciones de movimiento
def derivadas(estado):

    r = estado[:3]
    v = estado[3:]

    B = campo_marte(r)

    drdt = v

    dvdt = (
        q/(gamma*m)
        * np.cross(v, B)
    )

    return np.concatenate(
        (drdt, dvdt)
    )


# Integración mediante RK2
def rk2(estado0, dt, tiempo_total):

    pasos = int(
        tiempo_total/dt
    )

    estados = [
        estado0.copy()
    ]

    tiempos = [
        0.0
    ]

    for i in range(pasos):

        estado = estados[-1]

        k1 = derivadas(
            estado
        )

        estado_medio = (
            estado
            + dt*k1/2
        )

        k2 = derivadas(
            estado_medio
        )

        nuevo_estado = (
            estado
            + dt*k2
        )

        estados.append(
            nuevo_estado
        )

        tiempos.append(
            (i + 1)*dt
        )


        # Si el protón llega a la superficie,
        # dejo de integrar la trayectoria.
        if np.linalg.norm(
            nuevo_estado[:3]
        ) <= RM:

            break


    return (
        np.array(tiempos),
        np.array(estados)
    )


# El protón empieza lejos de Marte y desplazado
# respecto al eje x.
r0 = np.array([
    10.0*RM,
    3.0*RM,
    0.0
])


# La velocidad apunta exactamente hacia el centro de Marte.
direccion = (
    -r0
    / np.linalg.norm(r0)
)

v0 = (
    v_total
    * direccion
)


estado0 = np.concatenate(
    (r0, v0)
)


# Parámetros numéricos
dt = 5e-6

tiempo_total = 2.0


t, solucion = rk2(
    estado0,
    dt,
    tiempo_total
)


r = solucion[:, :3]
v = solucion[:, 3:]


# Posiciones expresadas en radios de Marte
x = r[:, 0] / RM
y = r[:, 1] / RM
z = r[:, 2] / RM


# Distancia al centro de Marte
distancia = (
    np.linalg.norm(
        r,
        axis=1
    )
    / RM
)


# Reviso la conservación de la rapidez
rapidez = np.linalg.norm(
    v,
    axis=1
)

rapidez_inicial = np.linalg.norm(
    v0
)

error_rapidez = (
    np.abs(
        rapidez
        - rapidez_inicial
    )
    / rapidez_inicial
) * 100


# Campo magnético encontrado por el protón
B_modulo = np.zeros(
    len(t)
)

for i in range(len(t)):

    B = campo_marte(
        r[i]
    )

    B_modulo[i] = np.linalg.norm(
        B
    )


# Busco la distancia mínima alcanzada
indice_minimo = np.argmin(
    distancia
)

distancia_minima = distancia[
    indice_minimo
]


# Esfera de Marte
u = np.linspace(
    0,
    2*np.pi,
    40
)

theta = np.linspace(
    0,
    np.pi,
    25
)

xs = np.outer(
    np.cos(u),
    np.sin(theta)
)

ys = np.outer(
    np.sin(u),
    np.sin(theta)
)

zs = np.outer(
    np.ones(len(u)),
    np.cos(theta)
)


# Trayectoria que seguiría el protón si no existiera campo
lambda_recta = np.linspace(
    0,
    1,
    300
)

recta = (
    r0[None, :]
    + lambda_recta[:, None]
    * (-r0[None, :])
)


# Trayectoria tridimensional
fig = plt.figure(
    figsize=(9, 8)
)

ax = fig.add_subplot(
    111,
    projection="3d"
)


ax.plot_surface(
    xs,
    ys,
    zs,
    alpha=0.4
)


salto = 10

ax.plot(
    x[::salto],
    y[::salto],
    z[::salto],
    linewidth=1.3,
    label="Trayectoria del protón"
)

ax.scatter(
    x[0],
    y[0],
    z[0],
    s=45,
    label="Posición inicial"
)


ax.plot(
    recta[:, 0]/RM,
    recta[:, 1]/RM,
    recta[:, 2]/RM,
    linestyle="--",
    linewidth=1,
    label="Trayectoria sin campo"
)


ax.set_xlim(
    -2,
    10.5
)

ax.set_ylim(
    -5,
    5
)

ax.set_zlim(
    -5,
    5
)

ax.set_xlabel(
    "x / $R_M$"
)

ax.set_ylabel(
    "y / $R_M$"
)

ax.set_zlabel(
    "z / $R_M$"
)

ax.set_title(
    "Protón incidente diagonalmente hacia Marte"
)

ax.legend()

plt.show()


# Vista en el plano x-y
plt.figure(
    figsize=(9, 6)
)

plt.plot(
    x,
    y,
    label="Con campo magnético"
)


plt.plot(
    recta[:, 0]/RM,
    recta[:, 1]/RM,
    linestyle="--",
    label="Sin campo magnético"
)


angulo = np.linspace(
    0,
    2*np.pi,
    400
)

plt.plot(
    np.cos(angulo),
    np.sin(angulo)
)


plt.scatter(
    x[0],
    y[0],
    s=40,
    label="Posición inicial"
)


plt.axis(
    "equal"
)

plt.xlabel(
    "x / $R_M$"
)

plt.ylabel(
    "y / $R_M$"
)

plt.title(
    "Desviación de una trayectoria incidente diagonal"
)

plt.grid()
plt.legend()

plt.show()


# Distancia al centro de Marte
plt.figure(
    figsize=(9, 5)
)

plt.plot(
    t,
    distancia
)

plt.axhline(
    1,
    linestyle="--"
)

plt.scatter(
    t[indice_minimo],
    distancia_minima,
    s=35
)

plt.xlabel(
    "Tiempo [s]"
)

plt.ylabel(
    r"$r/R_M$"
)

plt.title(
    "Distancia del protón al centro de Marte"
)

plt.grid()

plt.show()


# Campo magnético a lo largo de la trayectoria
plt.figure(
    figsize=(9, 5)
)

plt.plot(
    t,
    B_modulo
)

plt.xlabel(
    "Tiempo [s]"
)

plt.ylabel(
    "|B| [T]"
)

plt.title(
    "Campo magnético a lo largo de la trayectoria"
)

plt.grid()

plt.show()


# Error numérico
plt.figure(
    figsize=(9, 5)
)

plt.plot(
    t,
    error_rapidez
)

plt.xlabel(
    "Tiempo [s]"
)

plt.ylabel(
    "Error relativo [%]"
)

plt.title(
    "Error en la conservación de la rapidez"
)

