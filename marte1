# Integración con RK2
def rk2(estado0, dt, pasos):

    estados = np.zeros(
        (pasos + 1, 6)
    )

    estados[0] = estado0

    for i in range(pasos):

        k1 = derivadas(
            estados[i]
        )

        estado_medio = (
            estados[i]
            + dt*k1/2
        )

        k2 = derivadas(
            estado_medio
        )

        estados[i+1] = (
            estados[i]
            + dt*k2
        )

    return estados



