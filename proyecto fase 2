#funcion de actualización

def actualizar(i):

    rastro.set_data(
        x_anim[:i+1],
        y_anim[:i+1]
    )

    rastro.set_3d_properties(
        z_anim[:i+1]
    )

    particula.set_data(
        [x_anim[i]],
        [y_anim[i]]
    )

    particula.set_3d_properties(
        [z_anim[i]]
    )

    return rastro, particula



 CREAR ANIMACIÓN


animacion = FuncAnimation(
