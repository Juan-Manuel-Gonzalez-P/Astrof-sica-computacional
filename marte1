def linea_campo(seed, direccion, ds=0.005*RM, pasos=800):

    puntos = [
        seed.copy()
    ]

    r_linea = seed.copy()

    for i in range(pasos):

        B = campo_marte(
            r_linea
        )

        Bmag = np.linalg.norm(B)

        if Bmag == 0:
            break

        r_linea = (
            r_linea
            + direccion
            * ds
            * B/Bmag
        )

        distancia = np.linalg.norm(
            r_linea
        )

        if distancia <= RM:
            break

        if distancia >= 3*RM:
            break

        puntos.append(
            r_linea.copy()
        )

    return np.array(
        puntos
    )



